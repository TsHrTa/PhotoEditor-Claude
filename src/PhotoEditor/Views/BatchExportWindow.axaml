<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoEditor.ViewModels"
        x:Class="PhotoEditor.Views.BatchExportWindow"
        x:DataType="vm:BatchExportViewModel"
        Title="Export photos" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False">
    <StackPanel Margin="16" Spacing="10">
        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
            <TextBlock Text="Photos" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="1" Text="Folder" VerticalAlignment="Center" />
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Folder}" />
                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseClick" Margin="6,0,0,0" />
            </Grid>

            <TextBlock Grid.Row="2" Text="Format" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <RadioButton Content="JPEG" IsChecked="{Binding IsJpeg, Mode=OneWay}" Click="OnJpegClick" GroupName="format" />
                <RadioButton Content="PNG" IsChecked="{Binding IsPng}" GroupName="format" />
                <TextBlock Text="Quality" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsJpeg}" />
                <NumericUpDown Value="{Binding JpegQuality}" Minimum="1" Maximum="100" Increment="5" FormatString="0"
                               Width="120" IsVisible="{Binding IsJpeg}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Size" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <CheckBox Content="Long edge at most" IsChecked="{Binding Resize}" />
                <NumericUpDown Value="{Binding LongEdge}" Minimum="100" Maximum="20000" Increment="256" FormatString="0"
                               Width="130" IsEnabled="{Binding Resize}" />
                <TextBlock Text="px" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Add to the name" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Suffix}" Watermark="e.g. -edited (optional)" />

            <TextBlock Grid.Row="5" Text="If the file exists" VerticalAlignment="Center" />
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding IfExistsOptions}" SelectedItem="{Binding SelectedIfExists}"
                      HorizontalAlignment="Stretch" />
        </Grid>
        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Foreground="Gray" />
        <TextBlock Text="Each photo is exported with its saved edit (AI denoise / deblur included) as a background job; you can keep working meanwhile."
                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Export" Click="OnExportClick" IsEnabled="{Binding CanExport}" IsDefault="True" />
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
