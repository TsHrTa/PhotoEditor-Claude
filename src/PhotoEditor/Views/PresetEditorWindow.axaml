<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoEditor.ViewModels"
        x:Class="PhotoEditor.Views.PresetEditorWindow"
        x:DataType="vm:PresetEditorViewModel"
        Title="Edit preset" Width="620" Height="720" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="StepHeader" x:DataType="vm:StepViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Number, StringFormat='{}{0}.'}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move up" />
                <Button Grid.Column="2" Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move down" Margin="4,0" />
                <Button Grid.Column="3" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove step" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.step">
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding Name}" />
            </Grid>
            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                       Text="Steps run from top to bottom. A goal is measured on the photo and only corrected when it is not met. Steps that need AI (Select Subject / People / Sky) are skipped until the AI models are installed." />
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <TextBlock Text="Add step:" VerticalAlignment="Center" />
                <Button Content="Auto" Command="{Binding AddAutoCommand}" />
                <Button Content="Create mask" Command="{Binding AddMaskCommand}" />
                <Button Content="Set sliders" Command="{Binding AddValuesCommand}" />
                <Button Content="Goal" Command="{Binding AddGoalCommand}" />
            </WrapPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <TextBlock Text="{Binding TryLog}" TextWrapping="Wrap" Foreground="Gray" FontSize="12" IsVisible="{Binding HasTryLog}" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Content="Try on this photo" Command="{Binding TryOnPhotoCommand}" IsEnabled="{Binding CanTry}"
                        ToolTip.Tip="Run the preset as it is now on the open photo (undo with Ctrl+Z)" />
                <Button Grid.Column="2" Content="Save" Click="OnSaveClick" Margin="0,0,6,0" IsDefault="True" />
                <Button Grid.Column="3" Content="Cancel" Click="OnCancelClick" IsCancel="True" />
            </Grid>
        </StackPanel>

        <ScrollViewer Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:AutoStepViewModel">
                        <Border Classes="step">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeader}" />
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="vm:CurvesStepViewModel">
                        <Border Classes="step">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeader}" />
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="vm:MaskStepViewModel">
                        <Border Classes="step">
                            <StackPanel Spacing="6">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeader}" />
                                <Grid ColumnDefinitions="Auto,150,Auto,*">
                                    <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" Text="{Binding MaskName}" />
                                    <TextBlock Grid.Column="2" Text="from" VerticalAlignment="Center" Margin="10,0,6,0" />
                                    <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Static vm:MaskStepViewModel.Sources}" SelectedItem="{Binding Source}" />
                                </Grid>
                                <TextBlock Text="{Binding ShapeNote}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="vm:ValuesStepViewModel">
                        <Border Classes="step">
                            <StackPanel Spacing="6">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeader}" />
                                <Grid ColumnDefinitions="Auto,200,*">
                                    <TextBlock Text="On" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding Owner.RegionChoices}" Text="{Binding Target}" />
                                    <CheckBox Grid.Column="2" Content="add to the current values" IsChecked="{Binding Relative}" Margin="10,0,0,0" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ValueRowViewModel">
                                            <Grid ColumnDefinitions="*,130,Auto" Margin="0,0,0,4">
                                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:SliderOption.All}"
                                                          SelectedItem="{Binding Slider}" />
                                                <NumericUpDown Grid.Column="1" Value="{Binding Value}" Increment="1" FormatString="0.##" Margin="6,0" />
                                                <Button Grid.Column="2" Content="✕" Command="{Binding RemoveCommand}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="+ slider" Command="{Binding AddRowCommand}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="vm:GoalStepViewModel">
                        <Border Classes="step">
                            <StackPanel Spacing="6">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepHeader}" />
                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                    <ComboBox IsEditable="True" Width="160" ItemsSource="{Binding Owner.RegionChoices}" Text="{Binding RegionMask}" />
                                    <CheckBox Content="outside it" IsChecked="{Binding RegionOutside}" />
                                    <ComboBox Width="120" ItemsSource="{x:Static vm:GoalStepViewModel.Metrics}" SelectedItem="{Binding Metric}" />
                                    <TextBlock Text="should be" VerticalAlignment="Center" />
                                    <ComboBox Width="100" ItemsSource="{x:Static vm:GoalStepViewModel.Relations}" SelectedItem="{Binding Relation}" />
                                </WrapPanel>
                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                    <NumericUpDown Width="120" Value="{Binding Target}" Increment="1" FormatString="0.##" />
                                    <TextBlock Text="{Binding TargetUnit}" VerticalAlignment="Center" />
                                </WrapPanel>
                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                    <TextBlock Text="Reference" VerticalAlignment="Center" />
                                    <ComboBox IsEditable="True" Width="160" ItemsSource="{Binding Owner.ReferenceChoices}" Text="{Binding Reference}" />
                                    <CheckBox Content="outside it" IsChecked="{Binding ReferenceOutside}" IsVisible="{Binding HasReference}" />
                                </WrapPanel>
                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                    <TextBlock Text="If not met, change" VerticalAlignment="Center" />
                                    <ComboBox Width="200" ItemsSource="{x:Static vm:SliderOption.All}" SelectedItem="{Binding FixBy}" />
                                    <TextBlock Text="of" VerticalAlignment="Center" />
                                    <ComboBox IsEditable="True" Width="170" ItemsSource="{Binding Owner.FixChoices}" Text="{Binding FixMask}" />
                                </WrapPanel>
                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                    <TextBlock Text="by at most" VerticalAlignment="Center" />
                                    <NumericUpDown Width="110" Value="{Binding MaxChange}" Increment="0.1" Minimum="0" FormatString="0.##" />
                                    <TextBlock Text="tolerance" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <NumericUpDown Width="100" Value="{Binding Tolerance}" Increment="0.5" Minimum="0" FormatString="0.##" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</Window>
